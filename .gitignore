# ---------------------------------------------------------------------------
# v2 (intake-delivery / thesis-chapters)
# ---------------------------------------------------------------------------

# Instance-specific handles. A credential id and a workflow id mean nothing
# outside the one n8n instance they were issued by.
config.local.json
.workflow-id

# A build made from config.local.json carries the real Sheet id, the live
# sub-workflow id and per-instance credential ids. The committed workflow.json is
# built from config.example.json instead, so a rebuild cannot stage any of them.
workflow.local.json

# Generated by test/make-docx.js while checking the DOCX writer.
thesis-chapters/test/out.docx

# Intermediates
.tmp/
*.tmp
.cache/
